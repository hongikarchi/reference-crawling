        "building_images_check": {
          "definition": "CHECK (medium IS NULL AND spatial_context IS NULL AND framing_scale IS NULL AND camera_angle IS NULL AND drawing_kind IS NULL AND project_state IS NULL AND project_legibility IS NULL AND semantic_type = '{}'::text[] AND NOT is_cover_default AND cover_slot = '{}'::text[] AND engine IS NULL AND engine_version IS NULL OR medium IS NOT NULL AND project_legibility IS NOT NULL AND cardinality(semantic_type) >= 1 AND engine IS NOT NULL AND engine_version IS NOT NULL AND (medium = 'photograph'::text AND spatial_context IS NOT NULL AND framing_scale IS NOT NULL AND camera_angle IS NOT NULL AND drawing_kind IS NULL AND project_state IS NOT NULL OR medium = 'drawing'::text AND spatial_context IS NULL AND framing_scale IS NULL AND camera_angle IS NULL AND drawing_kind IS NOT NULL AND project_state IS NULL OR medium = 'rendering'::text AND spatial_context IS NOT NULL AND framing_scale IS NOT NULL AND camera_angle IS NOT NULL AND drawing_kind IS NOT NULL AND project_state IS NULL OR (medium = ANY (ARRAY['physical_model'::text, 'mixed'::text, 'other'::text, 'unknown'::text])) AND spatial_context IS NULL AND framing_scale IS NULL AND camera_angle IS NULL AND drawing_kind IS NULL AND project_state IS NULL))",
          "type": "c"
        },
        "building_images_check1": {
          "definition": "CHECK ((camera_angle <> ALL (ARRAY['aerial_oblique'::text, 'aerial_top_down'::text])) OR (spatial_context = ANY (ARRAY['exterior'::text, 'unknown'::text])))",
          "type": "c"
        },
        "building_images_check2": {
          "definition": "CHECK (NOT is_cover_default OR medium = 'photograph'::text)",
          "type": "c"
        },
        "building_images_check3": {
          "definition": "CHECK (NOT cover_slot && ARRAY['exterior'::text, 'interior'::text, 'aerial'::text, 'detail'::text] OR medium = 'photograph'::text)",
          "type": "c"
        },
        "building_images_check4": {
          "definition": "CHECK (NOT cover_slot @> ARRAY['drawing'::text] OR medium = 'drawing'::text)",
          "type": "c"
        },
        "building_images_cover_slot_check": {
