          "type": "c"
        },
        "building_images_medium_check": {
          "definition": "CHECK (medium = ANY (ARRAY['photograph'::text, 'drawing'::text, 'rendering'::text, 'physical_model'::text, 'mixed'::text, 'other'::text, 'unknown'::text]))",
          "type": "c"
        },
        "building_images_pkey": {
          "definition": "PRIMARY KEY (canonical_bld_id, image_asset_id)",
          "type": "p"
        },
        "building_images_project_legibility_check": {
          "definition": "CHECK (project_legibility = ANY (ARRAY['high'::text, 'medium'::text, 'low'::text, 'unknown'::text]))",
          "type": "c"
        },
        "building_images_project_state_check": {
          "definition": "CHECK (project_state = ANY (ARRAY['visibly_finished'::text, 'construction_visible'::text, 'ruin_or_abandoned_visible'::text, 'demolition_visible'::text, 'unknown'::text]))",
          "type": "c"
        },
        "building_images_projection_version_check": {
          "definition": "CHECK (length(TRIM(BOTH FROM projection_version)) > 0)",
          "type": "c"
        },
        "building_images_semantic_type_check": {
          "definition": "CHECK (semantic_type <@ ARRAY['exterior_overall'::text, 'exterior_context'::text, 'interior'::text, 'threshold'::text, 'drawing'::text, 'rendering'::text, 'physical_model'::text, 'aerial'::text, 'detail'::text, 'construction_archive'::text])",
          "type": "c"
        },
        "building_images_sort_order_check": {
