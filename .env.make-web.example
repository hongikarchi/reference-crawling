# Read-only archi_data credentials template — copy to `.env.make-web` (gitignored).
# Role `make_web`: SELECT-only on archi_data.public.canonical_v2_*.
# archi-tinder uses these as its `buildings` database (router blocks migrations).
# NEVER commit real values. For dev, point BUILDINGS_DB_HOST at the dev-ksangjo branch.
BUILDINGS_DB_HOST=      # Neon endpoint host (prod or branch)
BUILDINGS_DB_PORT=5432
BUILDINGS_DB_NAME=archi_data
BUILDINGS_DB_USER=make_web
BUILDINGS_DB_PASSWORD=
BUILDINGS_DB_SSLMODE=require
# Or compose a single URL:
# BUILDINGS_DB_URL=postgresql://<user>:<password>@<host>/archi_data?sslmode=require
