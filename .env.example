# make_db secrets template — copy to `.env` (gitignored) and fill values.
# NEVER commit real values. Values come from the owner via a secure channel.

# --- Neon archi_data (writer role, used by tools/canonical_v2_*_neon_loader.py) ---
# Alternatively set DATABASE_URL (takes precedence over DB_* in _connect).
DB_HOST=            # Neon endpoint host (prod or a branch endpoint)
DB_PORT=5432
DB_NAME=archi_data
DB_USER=            # writer role (owner only); collaborators use a branch + read-only role
DB_PASSWORD=
DB_SSLMODE=require

# --- Divisare crawler login (crawl/divisare) ---
DIVISARE_EMAIL=
DIVISARE_PASSWORD=

# --- Image hosting ---
IMAGE_BASE_URL=     # public base URL for re-hosted images (R2 currently unused)
# Optional, only if R2 re-hosting is resumed:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Neon management API (branch create/reset, schema snapshot tooling) ---
NEON_API_KEY=
NEON_PROJECT_ID=
